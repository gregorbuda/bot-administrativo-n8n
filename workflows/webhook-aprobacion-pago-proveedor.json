    {
      "parameters": {
        "jsCode": "const facturaActual = $json;\nconst montoPago = $('3 - Consulta Pago Actual').item.json.monto;\n\nconst nuevoMontoPagado = Number(facturaActual.monto_pagado) + Number(montoPago);\nconst nuevoEstado = nuevoMontoPagado >= facturaActual.monto_total ? 'pagada' : 'pendiente';\n\nreturn {\n  json: {\n    factura_id: facturaActual.id,\n    nuevo_monto_pagado: nuevoMontoPagado,\n    nuevo_estado: nuevoEstado\n  }\n};"
      },
