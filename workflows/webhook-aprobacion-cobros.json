    {
      "parameters": {
        "jsCode": "const nuevoSaldo = $('6b - Calcula Nuevos Saldos').item.json.nuevo_saldo;\nconst excedente = $('6b - Calcula Nuevos Saldos').item.json.monto_excedente;\nconst monto = $('3 - Consulta Cobro Actual').item.json.monto;\nconst numeroFactura = $('6a - Consulta Factura Actual').item.json.numero_factura;\n\nlet mensaje;\nif (nuevoSaldo === 0 && excedente > 0) {\n  mensaje = `✅ Tu pago de $${monto} para la factura ${numeroFactura} fue confirmado.\\n\\nLa factura quedó completamente saldada, y pagaste $${excedente} de más. Nuestro equipo se pondrá en contacto contigo para coordinar el excedente.`;\n} else if (nuevoSaldo === 0) {\n  mensaje = `✅ Tu pago de $${monto} para la factura ${numeroFactura} fue confirmado.\\n\\n¡La factura quedó completamente saldada! Gracias por tu pago.`;\n} else {\n  mensaje = `✅ Tu pago de $${monto} para la factura ${numeroFactura} fue confirmado.\\n\\nTodavía queda un saldo pendiente de $${nuevoSaldo} en esta factura.`;\n}\n\nreturn { json: { mensaje_cliente: mensaje } };"
      },
