    {
      "parameters": {
        "jsCode": "const factura = $('6a - Consulta Factura Actual').item.json;\nconst montoCobro = $('3 - Consulta Cobro Actual').item.json.monto;\n\nconst nuevoMontoPagado = parseFloat(factura.monto_pagado) + parseFloat(montoCobro);\nconst saldoSinAjustar = parseFloat(factura.saldo_pendiente) - parseFloat(montoCobro);\nconst montoExcedente = saldoSinAjustar < 0 ? Math.abs(saldoSinAjustar) : 0;\nconst nuevoSaldo = saldoSinAjustar < 0 ? 0 : saldoSinAjustar;\nconst nuevoEstado = nuevoSaldo <= 0 ? 'Pagada' : factura.estado;\n\nreturn {\n  json: {\n    factura_id: factura.id,\n    nuevo_monto_pagado: nuevoMontoPagado,\n    nuevo_saldo: nuevoSaldo,\n    nuevo_estado: nuevoEstado,\n    monto_excedente: montoExcedente\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
