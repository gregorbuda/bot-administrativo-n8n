        "jsonBody": "={\n  \"chat_id\": \"{{ $('10 - Verifica Formato Monto Proveedor').item.json.chat_id }}\",\n  \"text\": \"Perfecto, vas a pagar ${{ $('10 - Verifica Formato Monto Proveedor').item.json.monto }}. ¿Cuál es el método de pago?\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [{ \"text\": \"Transferencia\", \"callback_data\": \"metodoprov:transferencia\" }],\n      [{ \"text\": \"Pago Móvil\", \"callback_data\": \"metodoprov:pago_movil\" }],\n      [{ \"text\": \"Zelle\", \"callback_data\": \"metodoprov:zelle\" }]\n    ]\n  }\n}",
