    {
      "parameters": {
        "jsCode": "const datosTemp = JSON.parse($('Inicio').item.json.datos_temporales);\nconst pagoId = $('27 - Guarda Pago Proveedor').item.json.id;\n\nconst html = `\n  <h3>Nuevo pago reportado a proveedor</h3>\n  <p><strong>Factura:</strong> ${datosTemp.numero_factura}</p>\n  <p><strong>Proveedor:</strong> ${datosTemp.proveedor}</p>\n  <p><strong>Monto pagado:</strong> $${datosTemp.monto}</p>\n  <p><strong>Método:</strong> ${datosTemp.metodo_pago}</p>\n  <p><strong>Referencia:</strong> ${datosTemp.referencia}</p>\n  <br>\n  <p>\n    <a href=\"https://__N8N_HOST__/webhook/pago-proveedor-decision?pago_id=${pagoId}&accion=aprobar\" style=\"background:#22c55e;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;\">✅ Aprobar</a>\n    &nbsp;\n    <a href=\"https://__N8N_HOST__/webhook/pago-proveedor-decision?pago_id=${pagoId}&accion=rechazar\" style=\"background:#ef4444;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;\">❌ Rechazar</a>\n  </p>\n`;\n\nreturn {\n  json: {\n    gerente_email: $('27a - Consulta Email Gerente CxP').item.json.email,\n    asunto: `Nuevo pago a proveedor — ${datosTemp.proveedor} — $${datosTemp.monto}`,\n    html_body: html\n  }\n};"
      },
