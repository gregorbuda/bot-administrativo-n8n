    {
      "parameters": {
        "jsCode": "const texto = $('Inicio').item.json.mensaje_usuario;\nconst monto = parseFloat(texto);\nconst datosTemp = JSON.parse($('Inicio').item.json.datos_temporales);\n\nconst esNumeroValido = !isNaN(monto) && monto > 0 && /^\\d+(\\.\\d{1,2})?$/.test(texto.trim());\nconst noExcedeSaldo = esNumeroValido && monto <= datosTemp.saldo_pendiente;\n\nreturn {\n  json: {\n    monto_valido: esNumeroValido && noExcedeSaldo,\n    excede_saldo: esNumeroValido && !noExcedeSaldo,\n    monto: esNumeroValido ? monto : null,\n    datos_temp: datosTemp,\n    chat_id: $('Inicio').item.json.chat_id\n  }\n};"
      },
