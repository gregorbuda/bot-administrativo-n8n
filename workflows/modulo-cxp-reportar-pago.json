      "parameters": {
        "jsCode": "const facturas = $input.all().map(item => item.json);\nconst chat_id = $('Inicio').item.json.chat_id;\n\nconst inline_keyboard = facturas.map(f => ([{\n  text: `${f.numero_factura} - ${f.proveedor} - $${f.saldo_pendiente}`,\n  callback_data: `facturaprov:${f.factura_id}`\n}]));\n\nreturn {\n  json: {\n    chat_id: chat_id,\n    texto: 'Selecciona la factura de proveedor que deseas pagar:',\n    botones: JSON.stringify({ inline_keyboard })\n  }\n};"
      },
