        "jsCode": "const mensaje = $('Inicio').item.json.mensaje_usuario;\nconst metodo = mensaje.replace('metodoprov:', '');\nconst chat_id = $('Inicio').item.json.chat_id;\nconst datosTemp = JSON.parse($('Inicio').item.json.datos_temporales);\n\nconst metodosValidos = ['transferencia', 'pago_movil', 'zelle'];\nconst esValido = metodosValidos.includes(metodo);\n\nreturn {\n  json: {\n    metodo_valido: esValido,\n    metodo: esValido ? metodo : null,\n    chat_id: chat_id,\n    datos_temp: datosTemp\n  }\n};"
