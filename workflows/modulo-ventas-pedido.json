    {
      "parameters": {
        "jsCode": "const itemsCarrito = $('20 - Extrae Items Del Carrito').item.json.items;\nconst stockActual = $input.all().map(item => item.json);\nconst chat_id = $('20 - Extrae Items Del Carrito').item.json.chat_id;\nconst referencia_id = $('20 - Extrae Items Del Carrito').item.json.referencia_id;\n\nconst problemas = [];\nlet montoTotal = 0;\n\nfor (const item of itemsCarrito) {\n  const productoActual = stockActual.find(p => p.id === item.producto_id);\n  \n  if (!productoActual) {\n    problemas.push(`${item.nombre}: ya no está disponible`);\n    continue;\n  }\n  \n  if (item.cantidad > productoActual.stock_disponible) {\n    problemas.push(`${item.nombre}: solo quedan ${productoActual.stock_disponible} disponibles (pediste ${item.cantidad})`);\n    continue;\n  }\n  \n  montoTotal += item.subtotal;\n}\n\nreturn {\n  json: {\n    chat_id: chat_id,\n    referencia_id: referencia_id,\n    items: itemsCarrito,\n    monto_total: montoTotal,\n    hay_problemas: problemas.length > 0,\n    mensaje_problemas: problemas.join('\\n')\n  }\n};"
      },
