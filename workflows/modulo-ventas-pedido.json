    {
      "parameters": {
        "jsCode": "const items = $('22 - Valida Stock De Todo El Carrito').item.json.items;\nconst montoTotal = $('22 - Valida Stock De Todo El Carrito').item.json.monto_total;\nconst pedidoId = $('25 - Guarda Solicitud Pedido').item.json.id;\nconst vendedorEmail = $('26 - Consulta Email Vendedor').item.json.email;\nconst vendedorNombre = $('26 - Consulta Email Vendedor').item.json.nombre;\n\nconst filasItems = items.map(item => `\n  <tr>\n    <td style=\"padding:8px;border-bottom:1px solid #ddd;\">${item.codigo}</td>\n    <td style=\"padding:8px;border-bottom:1px solid #ddd;\">${item.nombre}</td>\n    <td style=\"padding:8px;border-bottom:1px solid #ddd;\">${item.cantidad}</td>\n    <td style=\"padding:8px;border-bottom:1px solid #ddd;\">$${item.precio_unitario}</td>\n    <td style=\"padding:8px;border-bottom:1px solid #ddd;\">$${item.subtotal}</td>\n  </tr>\n`).join('');\n\nconst html = `\n  <h3>Nueva solicitud de pedido</h3>\n  <table style=\"border-collapse:collapse;width:100%;\">\n    <thead>\n      <tr style=\"background:#f3f4f6;text-align:left;\">\n        <th style=\"padding:8px;\">Código</th>\n        <th style=\"padding:8px;\">Producto</th>\n        <th style=\"padding:8px;\">Cantidad</th>\n        <th style=\"padding:8px;\">Precio Unit.</th>\n        <th style=\"padding:8px;\">Subtotal</th>\n      </tr>\n    </thead>\n    <tbody>${filasItems}</tbody>\n  </table>\n  <p style=\"margin-top:16px;\"><strong>Total: $${montoTotal}</strong></p>\n  <br>\n  <p>\n    <a href=\"https://__N8N_HOST__/webhook/pedido-decision?pedido_id=${pedidoId}&accion=aprobar\" style=\"background:#22c55e;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;\">✅ Aprobar</a>\n    &nbsp;\n    <a href=\"https://__N8N_HOST__/webhook/pedido-decision?pedido_id=${pedidoId}&accion=rechazar\" style=\"background:#ef4444;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;\">❌ Rechazar</a>\n  </p>\n`;\n\nreturn {\n  json: {\n    vendedor_email: vendedorEmail,\n    asunto: `Nueva solicitud de pedido — $${montoTotal}`,\n    html_body: html\n  }\n};"
      },
