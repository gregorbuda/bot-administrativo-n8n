    {
      "parameters": {
        "jsCode": "const texto = $('Inicio').item.json.mensaje_usuario;\nconst cantidad = parseFloat(texto);\nconst datosTemp = JSON.parse($('Inicio').item.json.datos_temporales);\nconst productoActual = datosTemp.producto_actual;\n\nconst esNumeroValido = !isNaN(cantidad) && cantidad > 0 && /^\\d+(\\.\\d{1,2})?$/.test(texto.trim());\nconst hayStockSuficiente = esNumeroValido && cantidad <= productoActual.stock_disponible;\n\nreturn {\n  json: {\n    cantidad_valida: esNumeroValido && hayStockSuficiente,\n    formato_invalido: !esNumeroValido,\n    sin_stock: esNumeroValido && !hayStockSuficiente,\n    cantidad: esNumeroValido ? cantidad : null,\n    producto_actual: productoActual,\n    chat_id: $('Inicio').item.json.chat_id\n  }\n};"
      },
