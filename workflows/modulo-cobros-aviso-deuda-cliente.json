      "name": "8 - Envia Correo Aviso Deuda",
      "webhookId": "641bdeb2-ed44-469e-821f-fe345dca1b5f",
      "credentials": {
        "gmailOAuth2": {
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cliente = $('1 - Consulta Cliente Por Nombre').item.json;\nconst totalDeuda = $('7 - Arma Correo Aviso Deuda').item.json.total_deuda;\n\nreturn {\n  json: {\n    resultado: 'enviado',\n    mensaje: `Correo enviado a ${cliente.nombre} (${cliente.email}) con su saldo pendiente de $${totalDeuda.toFixed(2)}.`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        -192
      ],
      "id": "9935d858-7c20-4aff-81a4-25d47da3f3a7",
      "name": "9 - Responde Envio Exitoso"
    },
    {
      "parameters": {
        "jsCode": "const numeroFactura = $('Inicio').item.json.numero_factura;\nconst todasLasFacturas = $input.all().map(item => item.json);\n\nif (!numeroFactura || numeroFactura.trim() === '') {\n  return todasLasFacturas.map(f => ({ json: f }));\n}\n\nconst facturaEspecifica = todasLasFacturas.filter(f =>\n  f.numero_factura.toLowerCase() === numeroFactura.toLowerCase()\n);\n\nreturn facturaEspecifica.map(f => ({ json: f }));"
      },
      "type": "n8n-nodes-base.code",
