      "name": "5 - IF Tiene Deuda"
    },
    {
      "parameters": {
        "jsCode": "const nombreCliente = $('1 - Consulta Cliente Por Nombre').item.json.nombre;\n\nreturn {\n  json: {\n    resultado: 'sin_deuda',\n    mensaje: `${nombreCliente} no tiene ninguna deuda pendiente actualmente.`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        16
      ],
      "id": "30b8a87e-9d98-43f0-ac57-fdf1a2037b18",
      "name": "6 - Responde Sin Deuda"
    },
    {
      "parameters": {
        "jsCode": "const facturas = $input.all().map(item => item.json);\nconst cliente = $('1 - Consulta Cliente Por Nombre').item.json;\n\nconst totalDeuda = facturas.reduce((sum, f) => sum + Number(f.saldo_pendiente), 0);\n\nconst filasFacturas = facturas.map(f => `\n  <tr>\n    <td style=\"padding:10px;border-bottom:1px solid #e5e7eb;\">${f.numero_factura}</td>\n    <td style=\"padding:10px;border-bottom:1px solid #e5e7eb;\">${f.fecha_vencimiento}</td>\n    <td style=\"padding:10px;border-bottom:1px solid #e5e7eb;\">$${f.saldo_pendiente}</td>\n    <td style=\"padding:10px;border-bottom:1px solid #e5e7eb;color:${Number(f.dias_vencido) > 0 ? '#ef4444' : '#111827'};\">${f.dias_vencido > 0 ? f.dias_vencido + ' días vencida' : 'Al día'}</td>\n  </tr>\n`).join('');\n\nconst html = `\n  <div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;\">\n    <h2 style=\"color:#14213D;\">Aviso de saldo pendiente</h2>\n    <p>Estimado(a) ${cliente.nombre},</p>\n    <p>Le escribimos para informarle sobre el estado actual de su cuenta con nosotros.</p>\n    <table style=\"width:100%;border-collapse:collapse;margin:20px 0;\">\n      <thead>\n        <tr style=\"background:#f3f4f6;text-align:left;\">\n          <th style=\"padding:10px;\">Factura</th>\n          <th style=\"padding:10px;\">Vencimiento</th>\n          <th style=\"padding:10px;\">Saldo</th>\n          <th style=\"padding:10px;\">Estado</th>\n        </tr>\n      </thead>\n      <tbody>${filasFacturas}</tbody>\n    </table>\n    <p style=\"font-size:18px;font-weight:bold;color:#14213D;\">Total pendiente: $${totalDeuda.toFixed(2)}</p>\n    <p style=\"color:#6b7280;font-size:13px;margin-top:24px;\">Si ya realizó este pago, por favor ignore este mensaje. Ante cualquier duda, contáctenos.</p>\n  </div>\n`;\n\nreturn {\n  json: {\n    cliente_email: cliente.email,\n    asunto: `Aviso de saldo pendiente — $${totalDeuda.toFixed(2)}`,\n    html_body: html,\n    total_deuda: totalDeuda\n  }\n};"
      },
